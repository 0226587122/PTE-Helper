# Copy this file to .env and fill in the values you need.
# docker compose reads .env automatically. In production, set these on App Platform instead (see .do/app.yaml).

# --- Runtime ---
# "production" turns on strict checks (SSL database connection, strong JWT secret, secure cookies).
ENVIRONMENT=development
# Log level for the API: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- Database ---
# MySQL connection string. DigitalOcean's mysql://user:pass@host:port/db?ssl-mode=REQUIRED form is accepted
# and converted for PyMySQL automatically. docker compose sets this for you when running locally.
DATABASE_URL=mysql://pte:pte@localhost:3318/pte
# The Managed MySQL CA certificate (PEM text). Required in production; leave empty locally.
DATABASE_CA_CERT=
# Seconds before a pooled connection is refreshed. Keep this below the server's wait_timeout.
DB_POOL_RECYCLE=1800
# Connections kept open per API worker.
DB_POOL_SIZE=5
# A separate database for the API tests (created by docker/mysql-init). Never point this at real data.
TEST_DATABASE_URL=mysql://pte:pte@localhost:3318/pte_test

# --- Sign in ---
# Secret used to sign session tokens. Use a long random value in production, for example: openssl rand -hex 32
JWT_SECRET=local-development-secret
# How long a sign-in lasts, in hours.
JWT_EXPIRE_HOURS=168
# Send the session cookie over HTTPS only. Must be true in production; false for plain http://localhost.
COOKIE_SECURE=false

# --- Examiner feedback (Claude) ---
# Your Anthropic API key. Feedback is switched off with a friendly message when this is empty.
ANTHROPIC_API_KEY=
# The Claude model used for examiner feedback.
ANTHROPIC_MODEL=claude-sonnet-5
# Examiner feedback requests allowed per student per day (UTC).
FEEDBACK_DAILY_LIMIT=30

# --- Practice sets and the question pool ---
# Questions in every practice set.
QUESTIONS_PER_SET=15
# Retiring a question promotes backups until each type has at least this many active questions.
MIN_ACTIVE_PER_TYPE=30
# Questions from a student's last N sets of the same type are left out of new sets where possible.
RECENT_SETS_EXCLUDED=3
# Open reports needed to retire a question automatically.
REPORT_RETIRE_THRESHOLD=3

# --- Local ports (docker compose only) ---
# Host ports, in case these clash with other projects on your machine.
MYSQL_HOST_PORT=3318
API_HOST_PORT=8010
WEB_HOST_PORT=5174
